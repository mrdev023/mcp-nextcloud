        "type": "string"
      },
      "excerpt": {
        "type": "string"
      },
      "feedId": {
        "type": "integer"
      },
      "id": {
        "type": "integer"
      },
      "lastModified": {
        "type": "integer"
      },
      "publishedAt": {
        "type": "string"
      },
      "starred": {
        "type": "boolean"
      },
      "title": {
